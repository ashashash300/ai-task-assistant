# SQLite database connection for local application data.
DATABASE_URL=sqlite:///./ai_task_assistant.db

# AI provider selection. Supported values: openai or gemini.
AI_PROVIDER=openai

# OpenAI configuration for the /chat endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Google Gemini configuration for the /chat endpoint when AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Number of completed Gemini turns retained in persisted conversation history.
GEMINI_HISTORY_TURNS=5

# Retain persisted conversations for this many days. Must be a positive integer.
CONVERSATION_RETENTION_DAYS=30

# Authentication session settings. Keep Secure cookies enabled for HTTPS deployments.
# Set SESSION_COOKIE_SECURE=false only for local HTTP development.
SESSION_TTL_HOURS=24
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# Comma-separated browser origins allowed to request a CSRF token and use auth mutations.
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Single-process in-memory request limits. These values reset when the process restarts
# and are not shared by multiple workers or replicas.
LOGIN_IP_LIMIT=10
LOGIN_IP_WINDOW_SECONDS=60
LOGIN_EMAIL_LIMIT=5
LOGIN_EMAIL_WINDOW_SECONDS=300
REGISTER_IP_LIMIT=5
REGISTER_IP_WINDOW_SECONDS=3600
CSRF_IP_LIMIT=30
CSRF_IP_WINDOW_SECONDS=60
CHAT_USER_LIMIT=10
CHAT_USER_WINDOW_SECONDS=60
# Durable SQLite reservation per authenticated user and Asia/Taipei calendar day.
# It survives a restart, but counts requests rather than tokens or monetary cost.
CHAT_DAILY_QUOTA=50
# In-memory, single-process in-flight provider guard. Do not use multiple workers
# or replicas without replacing this with a shared coordination service.
CHAT_CONCURRENT_LIMIT=1

# Provider guardrails. Request quotas are not token or monetary budgets.
CHAT_INPUT_MAX_LENGTH=4000
PROVIDER_MAX_CALLS_PER_CHAT=5
PROVIDER_MAX_TOOL_ROUNDS=5
PROVIDER_REQUEST_TIMEOUT_SECONDS=30
PROVIDER_MAX_OUTPUT_TOKENS=512
